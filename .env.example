# Copy to .env and fill in. `docker compose up` refuses to start until the two secrets
# below are set, which is deliberate: both have failure modes that are silent.

# ---------------------------------------------------------------- required ----

# Signs session cookies. Rotating it signs everyone out. Generate, do not invent:
#   openssl rand -base64 48
SESSION_SECRET=

# The Postgres password. Only ever used between the two containers, but it is the whole of
# the database's security, so generate this one too. Hex rather than base64 deliberately:
# this value is interpolated into a postgres:// URL, and base64's "/" and "+" corrupt one.
#   openssl rand -hex 24
#
# Postgres reads this only when it first creates its data directory. Changing it later does
# nothing to the database and everything to the app, which then cannot log in — see the
# README if you need to rotate it.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- addresses ---

# The URL people type. This is what goes into invitation and password-reset links, so it
# must be the address they can actually reach — not the container's own.
APP_BASE_URL=http://localhost:3000

# Where the app listens on the host. Leave as loopback unless something else terminates
# TLS in front of it; set 0.0.0.0 to expose it to your network.
# APP_BIND=127.0.0.1
# APP_PORT=3000

# ---------------------------------------------------------------- email -------

# Leave SMTP_URL unset and no email is sent at all: invitation and reset links are printed
# to `docker compose logs app`, intact and usable. That is fine while you are the only
# person here, and is a dead end the first time you invite somebody — they get nothing.
# Any provider that speaks SMTP works: Resend, Postmark, SES, Mailgun, Fastmail.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=Atelier <no-reply@example.com>

# ---------------------------------------------------------------- tuning ------

# Which hours of the day, UTC, the nightly work runs at: retention purges, due-soon
# reminders, and the daily digest if an admin has turned it on.
# ATELIER_JOB_HOURS=3,7

# Largest single upload, in bytes. Default 25 MB. Files are stored in Postgres, so this
# is also a statement about how fast the database grows.
# ATELIER_MAX_BLOB_BYTES=26214400

# LOG_LEVEL=info
